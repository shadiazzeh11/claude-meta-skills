.DS_Store
*.session.jsonl
node_modules/
.env*

# Validation output (regenerated per run)
validation/results/*.json
!validation/results/.gitkeep

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Test fixtures regenerated by setup.sh (git repos, scratch state).
# These are recreated each validation run; not part of repo state.
validation/test-cases/*/*/project/.git/
validation/test-cases/*/*/project/*.txt
validation/test-cases/*/*/project/file_*.txt
validation/test-cases/*/*/other-dir/CLAUDE.md
validation/test-cases/*/*/project/CLAUDE.md

